// Multiplicador 16x11 com sinal (Two's Complement) - 100% Estrutural Completo
module multiplicador_16x11_sinalizado (
    input  [15:0] A, // Multiplicando (16 bits com sinal)
    input  [10:0] B, // Multiplicador (11 bits com sinal)
    output [26:0] S  // Produto (27 bits)
);

    // -------------------------------------------------------------------------
    // 1. GERAÇÃO DOS PRODUTOS PARCIAIS (Baugh-Wooley 16x11)
    // -------------------------------------------------------------------------
    wire [15:0] p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10;

    // Linha 0 (B[0])
    and (p0[0],  A[0],  B[0]);  and (p0[1],  A[1],  B[0]);  and (p0[2],  A[2],  B[0]);  and (p0[3],  A[3],  B[0]);
    and (p0[4],  A[4],  B[0]);  and (p0[5],  A[5],  B[0]);  and (p0[6],  A[6],  B[0]);  and (p0[7],  A[7],  B[0]);
    and (p0[8],  A[8],  B[0]);  and (p0[9],  A[9],  B[0]);  and (p0[10], A[10], B[0]);  and (p0[11], A[11], B[0]);
    and (p0[12], A[12], B[0]);  and (p0[13], A[13], B[0]);  and (p0[14], A[14], B[0]);  nand(p0[15], A[15], B[0]);

    // Linha 1 (B[1])
    and (p1[0],  A[0],  B[1]);  and (p1[1],  A[1],  B[1]);  and (p1[2],  A[2],  B[1]);  and (p1[3],  A[3],  B[1]);
    and (p1[4],  A[4],  B[1]);  and (p1[5],  A[5],  B[1]);  and (p1[6],  A[6],  B[1]);  and (p1[7],  A[7],  B[1]);
    and (p1[8],  A[8],  B[1]);  and (p1[9],  A[9],  B[1]);  and (p1[10], A[10], B[1]);  and (p1[11], A[11], B[1]);
    and (p1[12], A[12], B[1]);  and (p1[13], A[13], B[1]);  and (p1[14], A[14], B[1]);  nand(p1[15], A[15], B[1]);

    // Linha 2 (B[2])
    and (p2[0],  A[0],  B[2]);  and (p2[1],  A[1],  B[2]);  and (p2[2],  A[2],  B[2]);  and (p2[3],  A[3],  B[2]);
    and (p2[4],  A[4],  B[2]);  and (p2[5],  A[5],  B[2]);  and (p2[6],  A[6],  B[2]);  and (p2[7],  A[7],  B[2]);
    and (p2[8],  A[8],  B[2]);  and (p2[9],  A[9],  B[2]);  and (p2[10], A[10], B[2]);  and (p2[11], A[11], B[2]);
    and (p2[12], A[12], B[2]);  and (p2[13], A[13], B[2]);  and (p2[14], A[14], B[2]);  nand(p2[15], A[15], B[2]);

    // Linha 3 (B[3])
    and (p3[0],  A[0],  B[3]);  and (p3[1],  A[1],  B[3]);  and (p3[2],  A[2],  B[3]);  and (p3[3],  A[3],  B[3]);
    and (p3[4],  A[4],  B[3]);  and (p3[5],  A[5],  B[3]);  and (p3[6],  A[6],  B[3]);  and (p3[7],  A[7],  B[3]);
    and (p3[8],  A[8],  B[3]);  and (p3[9],  A[9],  B[3]);  and (p3[10], A[10], B[3]);  and (p3[11], A[11], B[3]);
    and (p3[12], A[12], B[3]);  and (p3[13], A[13], B[3]);  and (p3[14], A[14], B[3]);  nand(p3[15], A[15], B[3]);

    // Linha 4 (B[4])
    and (p4[0],  A[0],  B[4]);  and (p4[1],  A[1],  B[4]);  and (p4[2],  A[2],  B[4]);  and (p4[3],  A[3],  B[4]);
    and (p4[4],  A[4],  B[4]);  and (p4[5],  A[5],  B[4]);  and (p4[6],  A[6],  B[4]);  and (p4[7],  A[7],  B[4]);
    and (p4[8],  A[8],  B[4]);  and (p4[9],  A[9],  B[4]);  and (p4[10], A[10], B[4]);  and (p4[11], A[11], B[4]);
    and (p4[12], A[12], B[4]);  and (p4[13], A[13], B[4]);  and (p4[14], A[14], B[4]);  nand(p4[15], A[15], B[4]);

    // Linha 5 (B[5])
    and (p5[0],  A[0],  B[5]);  and (p5[1],  A[1],  B[5]);  and (p5[2],  A[2],  B[5]);  and (p5[3],  A[3],  B[5]);
    and (p5[4],  A[4],  B[5]);  and (p5[5],  A[5],  B[5]);  and (p5[6],  A[6],  B[5]);  and (p5[7],  A[7],  B[5]);
    and (p5[8],  A[8],  B[5]);  and (p5[9],  A[9],  B[5]);  and (p5[10], A[10], B[5]);  and (p5[11], A[11], B[5]);
    and (p5[12], A[12], B[5]);  and (p5[13], A[13], B[5]);  and (p5[14], A[14], B[5]);  nand(p5[15], A[15], B[5]);

    // Linha 6 (B[6])
    and (p6[0],  A[0],  B[6]);  and (p6[1],  A[1],  B[6]);  and (p6[2],  A[2],  B[6]);  and (p6[3],  A[3],  B[6]);
    and (p6[4],  A[4],  B[6]);  and (p6[5],  A[5],  B[6]);  and (p6[6],  A[6],  B[6]);  and (p6[7],  A[7],  B[6]);
    and (p6[8],  A[8],  B[6]);  and (p6[9],  A[9],  B[6]);  and (p6[10], A[10], B[6]);  and (p6[11], A[11], B[6]);
    and (p6[12], A[12], B[6]);  and (p6[13], A[13], B[6]);  and (p6[14], A[14], B[6]);  nand(p6[15], A[15], B[6]);

    // Linha 7 (B[7])
    and (p7[0],  A[0],  B[7]);  and (p7[1],  A[1],  B[7]);  and (p7[2],  A[2],  B[7]);  and (p7[3],  A[3],  B[7]);
    and (p7[4],  A[4],  B[7]);  and (p7[5],  A[5],  B[7]);  and (p7[6],  A[6],  B[7]);  and (p7[7],  A[7],  B[7]);
    and (p7[8],  A[8],  B[7]);  and (p7[9],  A[9],  B[7]);  and (p7[10], A[10], B[7]);  and (p7[11], A[11], B[7]);
    and (p7[12], A[12], B[7]);  and (p7[13], A[13], B[7]);  and (p7[14], A[14], B[7]);  nand(p7[15], A[15], B[7]);

    // Linha 8 (B[8])
    and (p8[0],  A[0],  B[8]);  and (p8[1],  A[1],  B[8]);  and (p8[2],  A[2],  B[8]);  and (p8[3],  A[3],  B[8]);
    and (p8[4],  A[4],  B[8]);  and (p8[5],  A[5],  B[8]);  and (p8[6],  A[6],  B[8]);  and (p8[7],  A[7],  B[8]);
    and (p8[8],  A[8],  B[8]);  and (p8[9],  A[9],  B[8]);  and (p8[10], A[10], B[8]);  and (p8[11], A[11], B[8]);
    and (p8[12], A[12], B[8]);  and (p8[13], A[13], B[8]);  and (p8[14], A[14], B[8]);  nand(p8[15], A[15], B[8]);

    // Linha 9 (B[9])
    and (p9[0],  A[0],  B[9]);  and (p9[1],  A[1],  B[9]);  and (p9[2],  A[2],  B[9]);  and (p9[3],  A[3],  B[9]);
    and (p9[4],  A[4],  B[9]);  and (p9[5],  A[5],  B[9]);  and (p9[6],  A[6],  B[9]);  and (p9[7],  A[7],  B[9]);
    and (p9[8],  A[8],  B[9]);  and (p9[9],  A[9],  B[9]);  and (p9[10], A[10], B[9]);  and (p9[11], A[11], B[9]);
    and (p9[12], A[12], B[9]);  and (p9[13], A[13], B[9]);  and (p9[14], A[14], B[9]);  nand(p9[15], A[15], B[9]);

    // Linha 10 (B[10] - Sinal negativo)
    nand(p10[0], A[0],  B[10]); nand(p10[1], A[1],  B[10]); nand(p10[2], A[2],  B[10]); nand(p10[3], A[3],  B[10]);
    nand(p10[4], A[4],  B[10]); nand(p10[5], A[5],  B[10]); nand(p10[6], A[6],  B[10]); nand(p10[7], A[7],  B[10]);
    nand(p10[8], A[8],  B[10]); nand(p10[9], A[9],  B[10]); nand(p10[10],A[10], B[10]); nand(p10[11],A[11], B[10]);
    nand(p10[12],A[12], B[10]); nand(p10[13],A[13], B[10]); nand(p10[14],A[14], B[10]); and (p10[15],A[15], B[10]);

    // -------------------------------------------------------------------------
    // 2. REDE DE SOMA ESTRUTURAL (16 bits de largura para cada estágio)
    // -------------------------------------------------------------------------
    buf (S[0], p0[0]);

    // Estágio 1: p0 + p1
    wire [15:0] s1, c1;
    somador_completo fa_1_0  (.A(p0[1]),  .B(p1[0]),  .cin(1'b0),   .S(S[1]),   .cout(c1[0]));
    somador_completo fa_1_1  (.A(p0[2]),  .B(p1[1]),  .cin(c1[0]),  .S(s1[1]),  .cout(c1[1]));
    somador_completo fa_1_2  (.A(p0[3]),  .B(p1[2]),  .cin(c1[1]),  .S(s1[2]),  .cout(c1[2]));
    somador_completo fa_1_3  (.A(p0[4]),  .B(p1[3]),  .cin(c1[2]),  .S(s1[3]),  .cout(c1[3]));
    somador_completo fa_1_4  (.A(p0[5]),  .B(p1[4]),  .cin(c1[3]),  .S(s1[4]),  .cout(c1[4]));
    somador_completo fa_1_5  (.A(p0[6]),  .B(p1[5]),  .cin(c1[4]),  .S(s1[5]),  .cout(c1[5]));
    somador_completo fa_1_6  (.A(p0[7]),  .B(p1[6]),  .cin(c1[5]),  .S(s1[6]),  .cout(c1[6]));
    somador_completo fa_1_7  (.A(p0[8]),  .B(p1[7]),  .cin(c1[6]),  .S(s1[7]),  .cout(c1[7]));
    somador_completo fa_1_8  (.A(p0[9]),  .B(p1[8]),  .cin(c1[7]),  .S(s1[8]),  .cout(c1[8]));
    somador_completo fa_1_9  (.A(p0[10]), .B(p1[9]),  .cin(c1[8]),  .S(s1[9]),  .cout(c1[9]));
    somador_completo fa_1_10 (.A(p0[11]), .B(p1[10]), .cin(c1[9]),  .S(s1[10]), .cout(c1[10]));
    somador_completo fa_1_11 (.A(p0[12]), .B(p1[11]), .cin(c1[10]), .S(s1[11]), .cout(c1[11]));
    somador_completo fa_1_12 (.A(p0[13]), .B(p1[12]), .cin(c1[11]), .S(s1[12]), .cout(c1[12]));
    somador_completo fa_1_13 (.A(p0[14]), .B(p1[13]), .cin(c1[12]), .S(s1[13]), .cout(c1[13]));
    somador_completo fa_1_14 (.A(p0[15]), .B(p1[14]), .cin(c1[13]), .S(s1[14]), .cout(c1[14]));
    somador_completo fa_1_15 (.A(1'b0),   .B(p1[15]), .cin(c1[14]), .S(s1[15]), .cout(c1[15]));

    // Estágio 2: s1 + p2
    wire [15:0] s2, c2;
    somador_completo fa_2_1  (.A(s1[1]),  .B(p2[0]),  .cin(1'b0),   .S(S[2]),   .cout(c2[0]));
    somador_completo fa_2_2  (.A(s1[2]),  .B(p2[1]),  .cin(c2[0]),  .S(s2[2]),  .cout(c2[1]));
    somador_completo fa_2_3  (.A(s1[3]),  .B(p2[2]),  .cin(c2[1]),  .S(s2[3]),  .cout(c2[2]));
    somador_completo fa_2_4  (.A(s1[4]),  .B(p2[3]),  .cin(c2[2]),  .S(s2[4]),  .cout(c2[3]));
    somador_completo fa_2_5  (.A(s1[5]),  .B(p2[4]),  .cin(c2[3]),  .S(s2[5]),  .cout(c2[4]));
    somador_completo fa_2_6  (.A(s1[6]),  .B(p2[5]),  .cin(c2[4]),  .S(s2[6]),  .cout(c2[5]));
    somador_completo fa_2_7  (.A(s1[7]),  .B(p2[6]),  .cin(c2[5]),  .S(s2[7]),  .cout(c2[6]));
    somador_completo fa_2_8  (.A(s1[8]),  .B(p2[7]),  .cin(c2[6]),  .S(s2[8]),  .cout(c2[7]));
    somador_completo fa_2_9  (.A(s1[9]),  .B(p2[8]),  .cin(c2[7]),  .S(s2[9]),  .cout(c2[8]));
    somador_completo fa_2_10 (.A(s1[10]), .B(p2[9]),  .cin(c2[8]),  .S(s2[10]), .cout(c2[9]));
    somador_completo fa_2_11 (.A(s1[11]), .B(p2[10]), .cin(c2[9]),  .S(s2[11]), .cout(c2[10]));
    somador_completo fa_2_12 (.A(s1[12]), .B(p2[11]), .cin(c2[10]), .S(s2[12]), .cout(c2[11]));
    somador_completo fa_2_13 (.A(s1[13]), .B(p2[12]), .cin(c2[11]), .S(s2[13]), .cout(c2[12]));
    somador_completo fa_2_14 (.A(s1[14]), .B(p2[13]), .cin(c2[12]), .S(s2[14]), .cout(c2[13]));
    somador_completo fa_2_15 (.A(s1[15]), .B(p2[14]), .cin(c2[13]), .S(s2[15]), .cout(c2[14]));

    // Estágio 3: s2 + p3
    wire [15:0] s3, c3;
    somador_completo fa_3_2  (.A(s2[2]),  .B(p3[0]),  .cin(1'b0),   .S(S[3]),   .cout(c3[0]));
    somador_completo fa_3_3  (.A(s2[3]),  .B(p3[1]),  .cin(c3[0]),  .S(s3[3]),  .cout(c3[1]));
    somador_completo fa_3_4  (.A(s2[4]),  .B(p3[2]),  .cin(c3[1]),  .S(s3[4]),  .cout(c3[2]));
    somador_completo fa_3_5  (.A(s2[5]),  .B(p3[3]),  .cin(c3[2]),  .S(s3[5]),  .cout(c3[3]));
    somador_completo fa_3_6  (.A(s2[6]),  .B(p3[4]),  .cin(c3[3]),  .S(s3[6]),  .cout(c3[4]));
    somador_completo fa_3_7  (.A(s2[7]),  .B(p3[5]),  .cin(c3[4]),  .S(s3[7]),  .cout(c3[5]));
    somador_completo fa_3_8  (.A(s2[8]),  .B(p3[6]),  .cin(c3[5]),  .S(s3[8]),  .cout(c3[6]));
    somador_completo fa_3_9  (.A(s2[9]),  .B(p3[7]),  .cin(c3[6]),  .S(s3[9]),  .cout(c3[7]));
    somador_completo fa_3_10 (.A(s2[10]), .B(p3[8]),  .cin(c3[7]),  .S(s3[10]), .cout(c3[8]));
    somador_completo fa_3_11 (.A(s2[11]), .B(p3[9]),  .cin(c3[8]),  .S(s3[11]), .cout(c3[9]));
    somador_completo fa_3_12 (.A(s2[12]), .B(p3[10]), .cin(c3[9]),  .S(s3[12]), .cout(c3[10]));
    somador_completo fa_3_13 (.A(s2[13]), .B(p3[11]), .cin(c3[10]), .S(s3[13]), .cout(c3[11]));
    somador_completo fa_3_14 (.A(s2[14]), .B(p3[12]), .cin(c3[11]), .S(s3[14]), .cout(c3[12]));
    somador_completo fa_3_15 (.A(s2[15]), .B(p3[13]), .cin(c3[12]), .S(s3[15]), .cout(c3[13]));

    // Estágio 4: s3 + p4
    wire [15:0] s4, c4;
    somador_completo fa_4_3  (.A(s3[3]),  .B(p4[0]),  .cin(1'b0),   .S(S[4]),   .cout(c4[0]));
    somador_completo fa_4_4  (.A(s3[4]),  .B(p4[1]),  .cin(c4[0]),  .S(s4[4]),  .cout(c4[1]));
    somador_completo fa_4_5  (.A(s3[5]),  .B(p4[2]),  .cin(c4[1]),  .S(s4[5]),  .cout(c4[2]));
    somador_completo fa_4_6  (.A(s3[6]),  .B(p4[3]),  .cin(c4[2]),  .S(s4[6]),  .cout(c4[3]));
    somador_completo fa_4_7  (.A(s3[7]),  .B(p4[4]),  .cin(c4[3]),  .S(s4[7]),  .cout(c4[4]));
    somador_completo fa_4_8  (.A(s3[8]),  .B(p4[5]),  .cin(c4[4]),  .S(s4[8]),  .cout(c4[5]));
    somador_completo fa_4_9  (.A(s3[9]),  .B(p4[6]),  .cin(c4[5]),  .S(s4[9]),  .cout(c4[6]));
    somador_completo fa_4_10 (.A(s3[10]), .B(p4[7]),  .cin(c4[6]),  .S(s4[10]), .cout(c4[7]));
    somador_completo fa_4_11 (.A(s3[11]), .B(p4[8]),  .cin(c4[7]),  .S(s4[11]), .cout(c4[8]));
    somador_completo fa_4_12 (.A(s3[12]), .B(p4[9]),  .cin(c4[8]),  .S(s4[12]), .cout(c4[9]));
    somador_completo fa_4_13 (.A(s3[13]), .B(p4[10]), .cin(c4[9]),  .S(s4[13]), .cout(c4[10]));
    somador_completo fa_4_14 (.A(s3[14]), .B(p4[11]), .cin(c4[10]), .S(s4[14]), .cout(c4[11]));
    somador_completo fa_4_15 (.A(s3[15]), .B(p4[12]), .cin(c4[11]), .S(s4[15]), .cout(c4[12]));

    // Estágio 5: s4 + p5
    wire [15:0] s5, c5;
    somador_completo fa_5_4  (.A(s4[4]),  .B(p5[0]),  .cin(1'b0),   .S(S[5]),   .cout(c5[0]));
    somador_completo fa_5_5  (.A(s4[5]),  .B(p5[1]),  .cin(c5[0]),  .S(s5[5]),  .cout(c5[1]));
    somador_completo fa_5_6  (.A(s4[6]),  .B(p5[2]),  .cin(c5[1]),  .S(s5[6]),  .cout(c5[2]));
    somador_completo fa_5_7  (.A(s4[7]),  .B(p5[3]),  .cin(c5[2]),  .S(s5[7]),  .cout(c5[3]));
    somador_completo fa_5_8  (.A(s4[8]),  .B(p5[4]),  .cin(c5[3]),  .S(s5[8]),  .cout(c5[4]));
    somador_completo fa_5_9  (.A(s4[9]),  .B(p5[5]),  .cin(c5[4]),  .S(s5[9]),  .cout(c5[5]));
    somador_completo fa_5_10 (.A(s4[10]), .B(p5[6]),  .cin(c5[5]),  .S(s5[10]), .cout(c5[6]));
    somador_completo fa_5_11 (.A(s4[11]), .B(p5[7]),  .cin(c5[6]),  .S(s5[11]), .cout(c5[7]));
    somador_completo fa_5_12 (.A(s4[12]), .B(p5[8]),  .cin(c5[7]),  .S(s5[12]), .cout(c5[8]));
    somador_completo fa_5_13 (.A(s4[13]), .B(p5[9]),  .cin(c5[8]),  .S(s5[13]), .cout(c5[9]));
    somador_completo fa_5_14 (.A(s4[14]), .B(p5[10]), .cin(c5[9]),  .S(s5[14]), .cout(c5[10]));
    somador_completo fa_5_15 (.A(s4[15]), .B(p5[11]), .cin(c5[10]), .S(s5[15]), .cout(c5[11]));

    // Estágio 6: s5 + p6
    wire [15:0] s6, c6;
    somador_completo fa_6_5  (.A(s5[5]),  .B(p6[0]),  .cin(1'b0),   .S(S[6]),   .cout(c6[0]));
    somador_completo fa_6_6  (.A(s5[6]),  .B(p6[1]),  .cin(c6[0]),  .S(s6[6]),  .cout(c6[1]));
    somador_completo fa_6_7  (.A(s5[7]),  .B(p6[2]),  .cin(c6[1]),  .S(s6[7]),  .cout(c6[2]));
    somador_completo fa_6_8  (.A(s5[8]),  .B(p6[3]),  .cin(c6[2]),  .S(s6[8]),  .cout(c6[3]));
    somador_completo fa_6_9  (.A(s5[9]),  .B(p6[4]),  .cin(c6[3]),  .S(s6[9]),  .cout(c6[4]));
    somador_completo fa_6_10 (.A(s5[10]), .B(p6[5]),  .cin(c6[4]),  .S(s6[10]), .cout(c6[5]));
    somador_completo fa_6_11 (.A(s5[11]), .B(p6[6]),  .cin(c6[5]),  .S(s6[11]), .cout(c6[6]));
    somador_completo fa_6_12 (.A(s5[12]), .B(p6[7]),  .cin(c6[6]),  .S(s6[12]), .cout(c6[7]));
    somador_completo fa_6_13 (.A(s5[13]), .B(p6[8]),  .cin(c6[7]),  .S(s6[13]), .cout(c6[8]));
    somador_completo fa_6_14 (.A(s5[14]), .B(p6[9]),  .cin(c6[8]),  .S(s6[14]), .cout(c6[9]));
